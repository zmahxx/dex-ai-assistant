{
  "name": "dexter-desktop-assistant",
  "version": "0.1.5",
  "private": true,
  "description": "Dexter (Dex), a security-conscious Windows desktop AI assistant",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "package": "tsc --noEmit && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.dexter.assistant",
    "productName": "Dexter",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis" }
  }
}
